{
  "components": {
    "responses": {},
    "schemas": {
      "Bean": {
        "additionalProperties": false,
        "description": "Bean resource returned by the API.",
        "properties": {
          "country": {
            "nullable": true,
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "process": {
            "nullable": true,
            "type": "string"
          },
          "region": {
            "nullable": true,
            "type": "string"
          },
          "roast_level": {
            "nullable": true,
            "type": "integer"
          },
          "slug": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "country",
          "region",
          "process",
          "roast_level"
        ],
        "title": "Bean",
        "type": "object"
      },
      "BrewLog": {
        "additionalProperties": false,
        "description": "A brew log returned by the API.",
        "properties": {
          "bean": {
            "$ref": "#/components/schemas/Bean"
          },
          "brew_method": {
            "allOf": [
              {
                "$ref": "#/components/schemas/BrewMethod"
              }
            ],
            "nullable": true
          },
          "flavor_notes": {
            "items": {
              "$ref": "#/components/schemas/FlavorNote"
            },
            "type": "array"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "location_name": {
            "nullable": true,
            "type": "string"
          },
          "logged_at": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "media": {
            "items": {
              "$ref": "#/components/schemas/MediaAttachment"
            },
            "type": "array"
          },
          "notes": {
            "nullable": true,
            "type": "string"
          },
          "place": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Place"
              }
            ],
            "nullable": true
          },
          "post_id": {
            "format": "uuid",
            "nullable": true,
            "type": "string"
          },
          "rating": {
            "maximum": 100,
            "minimum": 1,
            "nullable": true,
            "type": "integer"
          },
          "recipe": {
            "allOf": [
              {
                "$ref": "#/components/schemas/Recipe"
              }
            ],
            "nullable": true
          },
          "recipe_parameters": {
            "allOf": [
              {
                "$ref": "#/components/schemas/RecipeParameters"
              }
            ],
            "nullable": true
          }
        },
        "required": [
          "id",
          "bean",
          "logged_at"
        ],
        "title": "BrewLog",
        "type": "object"
      },
      "BrewLogCreateRequest": {
        "additionalProperties": false,
        "description": "Request body for creating a brew log.",
        "example": {
          "bean_id": "7c8f1b2a-3d4e-5f6a-7b8c-9d0e1f2a3b4c",
          "brew_method_id": "31e0c7e6-1ba6-4cf3-8a24-f7b195ffed36",
          "flavor_note_ids": [
            "e10f891b-7139-4328-88b8-ef7d5e921cf4"
          ],
          "id": "0f5f0d6a-0c66-4a5d-8a4d-f4f3416d55a7",
          "post": {
            "create": true
          },
          "rating": 88
        },
        "properties": {
          "barista_profile_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "type": "array"
          },
          "bean_id": {
            "format": "uuid",
            "type": "string"
          },
          "brew_method_id": {
            "format": "uuid",
            "nullable": true,
            "type": "string"
          },
          "flavor_note_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "type": "array"
          },
          "id": {
            "format": "uuid",
            "nullable": true,
            "type": "string"
          },
          "latitude": {
            "nullable": true,
            "type": "number"
          },
          "location_name": {
            "nullable": true,
            "type": "string"
          },
          "logged_at": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "longitude": {
            "nullable": true,
            "type": "number"
          },
          "media_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "type": "array"
          },
          "notes": {
            "nullable": true,
            "type": "string"
          },
          "place_id": {
            "format": "uuid",
            "nullable": true,
            "type": "string"
          },
          "post": {
            "allOf": [
              {
                "$ref": "#/components/schemas/PostCreateRequest"
              }
            ],
            "nullable": true
          },
          "rating": {
            "maximum": 100,
            "minimum": 1,
            "nullable": true,
            "type": "integer"
          },
          "recipe_id": {
            "format": "uuid",
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "bean_id"
        ],
        "title": "BrewLogCreateRequest",
        "type": "object"
      },
      "BrewLogOptionsResponse": {
        "additionalProperties": false,
        "description": "Picker data for creating or updating brew logs.",
        "properties": {
          "brew_methods": {
            "items": {
              "$ref": "#/components/schemas/BrewMethod"
            },
            "type": "array"
          },
          "flavor_notes": {
            "items": {
              "$ref": "#/components/schemas/FlavorNote"
            },
            "type": "array"
          },
          "rating_range": {
            "$ref": "#/components/schemas/RatingRange"
          }
        },
        "required": [
          "brew_methods",
          "flavor_notes",
          "rating_range"
        ],
        "title": "BrewLogOptionsResponse",
        "type": "object"
      },
      "BrewLogResponse": {
        "additionalProperties": false,
        "description": "Single brew log response.",
        "properties": {
          "brew_log": {
            "$ref": "#/components/schemas/BrewLog"
          }
        },
        "required": [
          "brew_log"
        ],
        "title": "BrewLogResponse",
        "type": "object"
      },
      "BrewLogUpdateRequest": {
        "additionalProperties": false,
        "description": "Request body for updating a brew log.",
        "example": {
          "notes": "Sweeter as it cooled.",
          "rating": 91
        },
        "properties": {
          "barista_profile_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "type": "array"
          },
          "bean_id": {
            "format": "uuid",
            "type": "string"
          },
          "brew_method_id": {
            "format": "uuid",
            "nullable": true,
            "type": "string"
          },
          "flavor_note_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "type": "array"
          },
          "latitude": {
            "nullable": true,
            "type": "number"
          },
          "location_name": {
            "nullable": true,
            "type": "string"
          },
          "logged_at": {
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "longitude": {
            "nullable": true,
            "type": "number"
          },
          "media_ids": {
            "items": {
              "format": "uuid",
              "type": "string"
            },
            "type": "array"
          },
          "notes": {
            "nullable": true,
            "type": "string"
          },
          "place_id": {
            "format": "uuid",
            "nullable": true,
            "type": "string"
          },
          "rating": {
            "maximum": 100,
            "minimum": 1,
            "nullable": true,
            "type": "integer"
          },
          "recipe_id": {
            "format": "uuid",
            "nullable": true,
            "type": "string"
          }
        },
        "title": "BrewLogUpdateRequest",
        "type": "object"
      },
      "BrewLogsResponse": {
        "additionalProperties": false,
        "description": "Brew log collection response.",
        "properties": {
          "brew_logs": {
            "items": {
              "$ref": "#/components/schemas/BrewLog"
            },
            "type": "array"
          }
        },
        "required": [
          "brew_logs"
        ],
        "title": "BrewLogsResponse",
        "type": "object"
      },
      "BrewMethod": {
        "additionalProperties": false,
        "description": "Brew method resource returned by the API.",
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "slug",
          "name"
        ],
        "title": "BrewMethod",
        "type": "object"
      },
      "ErrorResponse": {
        "description": "Error response with detail message.",
        "example": {
          "errors": {
            "detail": "Unauthorized"
          }
        },
        "properties": {
          "errors": {
            "properties": {
              "detail": {
                "type": "string"
              }
            },
            "type": "object"
          }
        },
        "title": "ErrorResponse",
        "type": "object"
      },
      "FlavorNote": {
        "additionalProperties": false,
        "description": "Flavor note resource returned by the API.",
        "properties": {
          "category": {
            "nullable": true,
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "slug",
          "category"
        ],
        "title": "FlavorNote",
        "type": "object"
      },
      "MagicLinkRequest": {
        "description": "Request body for sending a magic link email.",
        "example": {
          "email": "user@example.com"
        },
        "properties": {
          "email": {
            "description": "User's email address",
            "format": "email",
            "type": "string"
          }
        },
        "required": [
          "email"
        ],
        "title": "MagicLinkRequest",
        "type": "object"
      },
      "MagicLinkResponse": {
        "description": "Always returns success to prevent user enumeration.",
        "example": {
          "message": "If your email is registered, you will receive a login link shortly."
        },
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "title": "MagicLinkResponse",
        "type": "object"
      },
      "Media": {
        "additionalProperties": false,
        "description": "Media resource returned by the API.",
        "properties": {
          "alt_text": {
            "nullable": true,
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "media_type": {
            "type": "string"
          },
          "url": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "id",
          "media_type",
          "alt_text",
          "url"
        ],
        "title": "Media",
        "type": "object"
      },
      "MediaAttachment": {
        "additionalProperties": false,
        "description": "Media resource plus attachment ordering metadata.",
        "properties": {
          "media": {
            "$ref": "#/components/schemas/Media"
          },
          "position": {
            "type": "integer"
          }
        },
        "required": [
          "media",
          "position"
        ],
        "title": "MediaAttachment",
        "type": "object"
      },
      "MessageResponse": {
        "description": "Generic success message.",
        "example": {
          "message": "Logged out"
        },
        "properties": {
          "message": {
            "type": "string"
          }
        },
        "title": "MessageResponse",
        "type": "object"
      },
      "Place": {
        "additionalProperties": false,
        "description": "Place resource returned by the API.",
        "properties": {
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "slug": {
            "nullable": true,
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "slug"
        ],
        "title": "Place",
        "type": "object"
      },
      "PostCreateRequest": {
        "additionalProperties": false,
        "description": "Optional post creation request.",
        "example": {
          "create": true,
          "visibility": "global"
        },
        "properties": {
          "create": {
            "type": "boolean"
          },
          "visibility": {
            "enum": [
              "personal",
              "global",
              "unlisted"
            ],
            "type": "string"
          }
        },
        "required": [
          "create"
        ],
        "title": "PostCreateRequest",
        "type": "object"
      },
      "RatingRange": {
        "additionalProperties": false,
        "description": "Allowed rating range.",
        "properties": {
          "max": {
            "maximum": 100,
            "type": "integer"
          },
          "min": {
            "minimum": 1,
            "type": "integer"
          }
        },
        "required": [
          "min",
          "max"
        ],
        "title": "RatingRange",
        "type": "object"
      },
      "Recipe": {
        "additionalProperties": false,
        "description": "Recipe resource returned by the API.",
        "properties": {
          "grind_size": {
            "nullable": true,
            "type": "integer"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "name": {
            "type": "string"
          }
        },
        "required": [
          "id",
          "name",
          "grind_size"
        ],
        "title": "Recipe",
        "type": "object"
      },
      "RecipeParameters": {
        "additionalProperties": false,
        "description": "Recipe values captured on a brew log.",
        "properties": {
          "grind_size": {
            "nullable": true,
            "type": "integer"
          },
          "ratio": {
            "nullable": true,
            "type": "string"
          },
          "temperature": {
            "nullable": true,
            "type": "number"
          },
          "time": {
            "nullable": true,
            "type": "integer"
          }
        },
        "required": [
          "grind_size",
          "ratio",
          "temperature",
          "time"
        ],
        "title": "RecipeParameters",
        "type": "object"
      },
      "UserResponse": {
        "description": "Public user representation.",
        "example": {
          "confirmed_at": "2026-01-15T10:30:00Z",
          "email": "user@example.com",
          "id": "7c8f1b2a-3d4e-5f6a-7b8c-9d0e1f2a3b4c",
          "role": "user"
        },
        "properties": {
          "confirmed_at": {
            "description": "When the user confirmed their email, or null",
            "format": "date-time",
            "nullable": true,
            "type": "string"
          },
          "email": {
            "format": "email",
            "type": "string"
          },
          "id": {
            "format": "uuid",
            "type": "string"
          },
          "role": {
            "enum": [
              "user",
              "admin"
            ],
            "type": "string"
          }
        },
        "title": "UserResponse",
        "type": "object"
      },
      "VerifyRequest": {
        "description": "Exchange a magic link token for a bearer API token.",
        "example": {
          "token": "SFMyNTY..."
        },
        "properties": {
          "token": {
            "description": "Magic link token extracted from the login URL",
            "type": "string"
          }
        },
        "required": [
          "token"
        ],
        "title": "VerifyRequest",
        "type": "object"
      },
      "VerifyResponse": {
        "description": "Bearer token and user info returned after successful verification.",
        "example": {
          "token": "bGl2ZV9hcGlfdG9rZW4...",
          "user": {
            "confirmed_at": "2026-01-15T10:30:00Z",
            "email": "user@example.com",
            "id": "7c8f1b2a-3d4e-5f6a-7b8c-9d0e1f2a3b4c",
            "role": "user"
          }
        },
        "properties": {
          "token": {
            "description": "Bearer API token",
            "type": "string"
          },
          "user": {
            "$ref": "#/components/schemas/UserResponse"
          }
        },
        "title": "VerifyResponse",
        "type": "object"
      }
    },
    "securitySchemes": {
      "bearer": {
        "description": "Bearer token obtained from POST /api/v1/auth/verify",
        "scheme": "bearer",
        "type": "http"
      }
    }
  },
  "info": {
    "description": "API for the Brewer coffee community platform.",
    "title": "Brewer API",
    "version": "1.0.0"
  },
  "openapi": "3.0.0",
  "paths": {
    "/api/v1/auth/logout": {
      "delete": {
        "callbacks": {},
        "description": "Revokes the current bearer token. Requires authentication.",
        "operationId": "BrewerWeb.API.V1.AuthController.logout",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MessageResponse"
                }
              }
            },
            "description": "Logged out"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing or invalid token"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Revoke bearer token",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/v1/auth/magic-link": {
      "post": {
        "callbacks": {},
        "description": "Sends a magic link email to the given address. Creates an account if the email is not yet registered. Always returns 200 to prevent user enumeration. The email contains the standard web URL which the mobile app intercepts via deep link to extract the token.",
        "operationId": "BrewerWeb.API.V1.AuthController.magic_link",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/MagicLinkRequest"
              }
            }
          },
          "description": "Magic link request",
          "required": false
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MagicLinkResponse"
                }
              }
            },
            "description": "Magic link sent"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Rate limited"
          }
        },
        "summary": "Request magic link",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "callbacks": {},
        "description": "Returns the current authenticated user. Requires authentication.",
        "operationId": "BrewerWeb.API.V1.AuthController.me",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyResponse"
                }
              }
            },
            "description": "Current user"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing or invalid token"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Get current user",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "callbacks": {},
        "description": "Revokes all existing API tokens for the current user and issues a new one. Requires authentication.",
        "operationId": "BrewerWeb.API.V1.AuthController.refresh",
        "parameters": [],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyResponse"
                }
              }
            },
            "description": "New token issued"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing or invalid token"
          }
        },
        "security": [
          {
            "bearer": []
          }
        ],
        "summary": "Refresh bearer token",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/v1/auth/verify": {
      "post": {
        "callbacks": {},
        "description": "The mobile app extracts the token from the deep link URL and sends it here. Returns a bearer API token on success.",
        "operationId": "BrewerWeb.API.V1.AuthController.verify",
        "parameters": [],
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/VerifyRequest"
              }
            }
          },
          "description": "Verify request",
          "required": false
        },
        "responses": {
          "201": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerifyResponse"
                }
              }
            },
            "description": "Token issued"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Invalid or expired token"
          },
          "429": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Rate limited"
          }
        },
        "summary": "Exchange magic link token for bearer token",
        "tags": [
          "Authentication"
        ]
      }
    },
    "/api/v1/brew-logs": {
      "get": {
        "callbacks": {},
        "description": "Returns brew logs scoped to the authenticated profile.",
        "operationId": "BrewerWeb.API.V1.BrewLogController.index",
        "parameters": [
          {
            "description": "Page number, starting at 1.",
            "in": "query",
            "name": "page",
            "required": false,
            "schema": {
              "default": 1,
              "minimum": 1,
              "type": "integer"
            }
          },
          {
            "description": "Items per page, capped at 100.",
            "in": "query",
            "name": "per_page",
            "required": false,
            "schema": {
              "default": 20,
              "maximum": 100,
              "minimum": 1,
              "type": "integer"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/BrewLogsResponse"
                }
              }
            },
            "description": "Brew logs"
          },
          "401": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            },
            "description": "Missing or invalid token"
