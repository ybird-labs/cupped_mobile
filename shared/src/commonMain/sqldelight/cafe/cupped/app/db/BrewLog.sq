-- Local materialized brew-log state — the UI reads this table.
-- Architecture §5.1. Column types/nullability mirror the spec exactly.
CREATE TABLE brew_logs (
    id TEXT NOT NULL PRIMARY KEY,          -- client-generated UUID for offline creates
    user_id TEXT NOT NULL,

    bean_id TEXT,                          -- canonical id once known
    bean_client_id TEXT,                   -- stable local id for a not-yet-synced new bean
    bean_draft_json TEXT,                  -- the NewDraft bean, present until synced
    recipe_id TEXT,
    recipe_client_id TEXT,
    recipe_draft_json TEXT,
    brew_method_id TEXT,
    flavor_note_ids TEXT,                  -- JSON array of catalog ids (denormalized)
    rating INTEGER,                        -- 1..100 (validation in domain; no DB CHECK)
    notes TEXT,
    location_name TEXT,
    logged_at_iso TEXT,                    -- display only

    sync_status TEXT NOT NULL DEFAULT 'synced',
    local_revision INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,           -- client epoch millis, stable UI ordering
    local_updated_at INTEGER NOT NULL,     -- client epoch millis, diagnostic
    deleted_at INTEGER,
    last_sync_error TEXT
);

CREATE INDEX brew_logs_user_idx        ON brew_logs(user_id);
CREATE INDEX brew_logs_sync_status_idx ON brew_logs(sync_status);
CREATE INDEX brew_logs_deleted_at_idx  ON brew_logs(deleted_at);
