-- Local materialized brew-log state — the UI reads this table.
-- Architecture §5.1. Column types/nullability mirror the spec exactly.
CREATE TABLE brew_logs (
    id TEXT NOT NULL PRIMARY KEY,          -- client-generated UUID for offline creates
    profile_id TEXT NOT NULL,

    bean_id TEXT,                          -- canonical id once known
    bean_client_id TEXT,                   -- stable local id for a not-yet-synced new bean
    bean_draft_json TEXT,                  -- the NewDraft bean, present until synced
    recipe_id TEXT,
    recipe_client_id TEXT,
    recipe_draft_json TEXT,
    brew_method_id TEXT,
    flavor_note_ids TEXT,                  -- JSON array of catalog ids (denormalized)
    rating INTEGER,                        -- 1..100 (validation in domain; no DB CHECK)
    notes TEXT,
    -- Location (architecture §5.1, decision 2026-05-29): coordinates != place.
    -- latitude/longitude are captured on EVERY log (raw device coords, exist even
    -- at home). They are nullable ONLY to preserve the local-first invariant that a
    -- write never fails when there's no GPS fix / location permission.
    latitude REAL,
    longitude REAL,
    -- The coffee shop ("place") is OPTIONAL / user-skippable: a free-text name and a
    -- soft ref (no FK) to a registered Place. Both null when drinking at home.
    location_name TEXT,
    place_id TEXT,
    logged_at_iso TEXT,                    -- display only

    sync_status TEXT NOT NULL DEFAULT 'synced',
    local_revision INTEGER NOT NULL DEFAULT 0,
    created_at INTEGER NOT NULL,           -- client epoch millis, stable UI ordering
    local_updated_at INTEGER NOT NULL,     -- client epoch millis, diagnostic
    deleted_at INTEGER,
    last_sync_error TEXT
);

CREATE INDEX brew_logs_profile_idx     ON brew_logs(profile_id);
CREATE INDEX brew_logs_sync_status_idx ON brew_logs(sync_status);
CREATE INDEX brew_logs_deleted_at_idx  ON brew_logs(deleted_at);

insertPendingCreate:
INSERT INTO brew_logs(
    id,
    profile_id,
    bean_id,
    bean_client_id,
    bean_draft_json,
    recipe_id,
    recipe_client_id,
    recipe_draft_json,
    brew_method_id,
    flavor_note_ids,
    rating,
    notes,
    latitude,
    longitude,
    location_name,
    place_id,
    logged_at_iso,
    sync_status,
    local_revision,
    created_at,
    local_updated_at,
    deleted_at,
    last_sync_error
) VALUES (
    :id,
    :profile_id,
    :bean_id,
    :bean_client_id,
    :bean_draft_json,
    :recipe_id,
    :recipe_client_id,
    :recipe_draft_json,
    :brew_method_id,
    :flavor_note_ids,
    :rating,
    :notes,
    :latitude,
    :longitude,
    :location_name,
    :place_id,
    :logged_at_iso,
    'pending_create',
    1,
    :created_at,
    :local_updated_at,
    NULL,
    NULL
);

selectLocalBrewLogById:
SELECT * FROM brew_logs
WHERE profile_id = :profile_id AND id = :id;

selectLocalJournalByProfile:
SELECT * FROM brew_logs
WHERE profile_id = :profile_id
  AND deleted_at IS NULL
  AND sync_status != 'no_op'
ORDER BY created_at DESC, id DESC;

countRowsByProfile:
SELECT count(*) FROM brew_logs WHERE profile_id = :profile_id;
