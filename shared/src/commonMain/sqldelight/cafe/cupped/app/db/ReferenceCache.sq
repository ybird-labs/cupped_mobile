-- Reference caches (architecture §5.5).
-- brew_method_cache and flavor_note_cache are read-only catalogs and never appear in the outbox.
-- bean_cache can also store optimistic profile-owned beans that sync through sync_outbox entity_type='bean'.

CREATE TABLE brew_method_cache (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    slug TEXT NOT NULL
);

CREATE TABLE flavor_note_cache (
    id TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    slug TEXT NOT NULL,
    category TEXT
);

CREATE TABLE bean_cache (
    id TEXT NOT NULL PRIMARY KEY,
    profile_id TEXT,
    name TEXT NOT NULL,                     -- NOT NULL per domain Bean (N4)
    slug TEXT,                              -- slug per domain Bean (N4)
    country TEXT,
    region TEXT,
    process TEXT,
    roast_level INTEGER,
    payload_json TEXT
);

CREATE TABLE recipe_cache (
    id TEXT NOT NULL PRIMARY KEY,
    profile_id TEXT,
    name TEXT NOT NULL,                     -- NOT NULL: domain Recipe.name is non-null (N5)
    grind_size INTEGER,
    water_temp_f INTEGER,
    ratio REAL,
    payload_json TEXT
);

upsertExistingBeanCache:
INSERT INTO bean_cache(
    id,
    profile_id,
    name,
    slug,
    country,
    region,
    process,
    roast_level,
    payload_json
) VALUES (
    :id,
    NULL,
    :name,
    :slug,
    :country,
    :region,
    :process,
    :roast_level,
    NULL
)
ON CONFLICT(id) DO UPDATE SET
    profile_id = COALESCE(bean_cache.profile_id, excluded.profile_id),
    name = excluded.name,
    slug = excluded.slug,
    country = excluded.country,
    region = excluded.region,
    process = excluded.process,
    roast_level = excluded.roast_level,
    payload_json = COALESCE(bean_cache.payload_json, excluded.payload_json);

insertOptimisticBean:
INSERT INTO bean_cache(
    id,
    profile_id,
    name,
    slug,
    country,
    region,
    process,
    roast_level,
    payload_json
) VALUES (
    :id,
    :profile_id,
    :name,
    NULL,
    :country,
    :region,
    :process,
    :roast_level,
    :payload_json
);

selectBeanForProfile:
SELECT * FROM bean_cache
WHERE id = :id AND (profile_id = :profile_id OR profile_id IS NULL)
ORDER BY CASE WHEN profile_id = :profile_id THEN 0 ELSE 1 END
LIMIT 1;

selectOptimisticBeanForProfile:
SELECT * FROM bean_cache
WHERE id = :id AND profile_id = :profile_id;
